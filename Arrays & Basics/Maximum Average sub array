class Solution:
    def findMaxAverage(self, nums: List[int], k: int) -> float:
        window=sum(nums[:k])
        maxlength=window
        for i in range(k,len(nums)):
            window += nums[i]
            window -= nums[i-k]

            maxlength=max(maxlength,window)
        return maxlength/k
        
