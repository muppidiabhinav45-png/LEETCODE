class Solution:
    def findMedianSortedArrays(self, nums1: List[int], nums2: List[int]) -> float:
      nums1.extend(nums2)
      nums1.sort()
      l=len(nums1)
      mid=l//2
      median=0
      if l % 2 == 0:
        median=(nums1[mid]+nums1[mid-1])/2
        
      else:
        median = nums1[mid]    
      return median



        
        
